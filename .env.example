# Copy to .env and fill in. Never commit .env.
# Only needed for live mode. Get a key at https://console.anthropic.com
# (API access is billed separately from a Claude.ai Pro/Max subscription.)
ANTHROPIC_API_KEY=

# mock (default, offline, free) | live (real API calls)
EVAL_MODE=mock

# 1 = make the mock bot misbehave, to demo the evals catching failures
EVAL_INJECT_BUGS=0
