// Golden Q&A set: real user questions + reference answers. Add a case for EVERY production bug.
{"id": "gq-refund-window", "question": "How many days do I have to return an item for a refund?", "reference": "Items can be returned for a refund within 30 days of delivery.", "must_include": ["30 days"], "must_not_include": ["60 days", "90 days"], "tags": ["refunds"]}
{"id": "gq-express-time", "question": "How long does express shipping take?", "reference": "Express shipping takes 1-2 business days and costs $15.", "must_include": ["1-2 business days"], "must_not_include": [], "tags": ["shipping"]}
{"id": "gq-cod", "question": "Can I pay with cash on delivery?", "reference": "Cash on delivery is not available.", "must_include": ["not available"], "must_not_include": [], "tags": ["payments"]}
{"id": "gq-points-expiry", "question": "When do my loyalty points expire?", "reference": "Loyalty points expire after 12 months.", "must_include": ["12 months"], "must_not_include": [], "tags": ["loyalty"]}
{"id": "gq-accidental-damage", "question": "Does the warranty cover accidental damage?", "reference": "Accidental damage is not covered by the warranty.", "must_include": ["not covered"], "must_not_include": [], "tags": ["warranty"]}
{"id": "gq-cancel-window", "question": "How soon must I cancel an order to avoid a charge?", "reference": "Orders can be cancelled free of charge within 2 hours of placing them.", "must_include": ["2 hours"], "must_not_include": [], "tags": ["orders"]}
{"id": "gq-international", "question": "Do you ship internationally?", "reference": "We ship internationally to 40 countries.", "must_include": ["40 countries"], "must_not_include": [], "tags": ["shipping"]}
{"id": "gq-customs", "question": "Who pays customs duties on international orders?", "reference": "Customs duties are paid by the customer.", "must_include": ["customer"], "must_not_include": [], "tags": ["shipping"]}
{"id": "gq-abstain-giftcards", "question": "Do you sell gift cards?", "reference": "I don't have information about that.", "must_include": ["don't have information"], "must_not_include": ["we sell gift cards", "gift cards are available"], "tags": ["abstention", "hallucination"]}
{"id": "gq-abstain-crypto", "question": "Can I pay using Bitcoin or other crypto?", "reference": "I don't have information about that.", "must_include": [], "must_not_include": ["bitcoin is accepted", "we accept crypto", "we accept bitcoin"], "tags": ["abstention", "hallucination"]}
